from pathlib import Path
import zipfile

root = Path("/mnt/data/cuda-hello-world")
root.mkdir(exist_ok=True)

files = {
    "CMakeLists.txt": """cmake_minimum_required(VERSION 3.24)
project(cuda_hello_world LANGUAGES CXX CUDA)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CUDA_STANDARD 17)
set(CMAKE_CUDA_ARCHITECTURES native)

add_executable(cuda_hello_world src/main.cu)
""",
    "src/main.cu": r'''#include <cuda_runtime.h>

#include <cstdio>
#include <cstdlib>
#include <iostream>

#define CUDA_CHECK(call)                                                     \
    do {                                                                      \
        cudaError_t err = (call);                                             \
        if (err != cudaSuccess) {                                             \
            std::cerr << "CUDA error: " << cudaGetErrorString(err)            \
                      << " (" << __FILE__ << ":" << __LINE__ << ")\n";        \
            return EXIT_FAILURE;                                             \
        }                                                                     \
    } while (0)

__global__ void hello_gpu() {
    int id = blockIdx.x * blockDim.x + threadIdx.x;

    if (id < 32) {
        printf("Hello from GPU! Thread %d says: GPU GO BRRRRRRRRRRR!\n", id);
    }
}

int main() {
    int deviceCount = 0;
    CUDA_CHECK(cudaGetDeviceCount(&deviceCount));

    if (deviceCount == 0) {
        std::cerr << "No CUDA GPU found.\n";
        return EXIT_FAILURE;
    }

    cudaDeviceProp prop{};
    CUDA_CHECK(cudaGetDeviceProperties(&prop, 0));

    std::cout << "CUDA Hello World\n";
    std::cout << "================\n";
    std::cout << "GPU: " << prop.name << "\n";
    std::cout << "Compute capability: "
              << prop.major << "." << prop.minor << "\n";
    std::cout << "CUDA runtime version: "
              << (cudaRuntimeGetVersion, 0) << "\n";

    // Launch 256 threads. The kernel deliberately prints from 32 of them.
    hello_gpu<<<1, 256>>>();
    CUDA_CHECK(cudaGetLastError());
    CUDA_CHECK(cudaDeviceSynchronize());

    std::cout << "GPU kernel completed successfully.\n";
    return EXIT_SUCCESS;
}
''',
    "README.md": """# CUDA Hello World

A tiny CUDA project whose only purpose is to make the GPU go **BRRRRRRRRRRR**.

The program:

- Detects a CUDA-capable GPU
- Prints the GPU name and compute capability
- Launches a CUDA kernel with 256 GPU threads
- Has 32 GPU threads print a message
- Synchronizes with the GPU and verifies that the kernel completed

## Requirements

- NVIDIA GPU
- NVIDIA driver with CUDA support
- CUDA Toolkit 13.4+
- CMake 3.24+

## Build

```bash
cmake -S . -B build
cmake --build build -j